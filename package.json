{
  "name": "dsh-sidebar-tuner",
  "version": "0.2.2",
  "description": "DSH 桌面端侧栏与对话区排版：中英文字体（自动检测本机是否安装）、字号、行高、行距、图标列 + 会话列两栏布局、图标悬停名称、对话区与代码字体，配可视化设置面板。纯样式注入，不改动其它插件。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "tangolee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangolee/dsh-sidebar-tuner.git"
  },
  "homepage": "https://github.com/tangolee/dsh-sidebar-tuner#readme",
  "bugs": {
    "url": "https://github.com/tangolee/dsh-sidebar-tuner/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "theme",
    "font"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./css": "./css.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "css.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    }
  }
}
