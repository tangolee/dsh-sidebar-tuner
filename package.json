{
  "name": "dsh-sidebar-tuner",
  "version": "0.3.6",
  "description": "DSH 桌面端侧栏样式与对话区排版：字体选择与修改（本机安装检测）、双栏布局、桌面端图标列设置、终端字体，配可视化设置面板。纯样式注入，不改动其它插件。 | Typography and layout for the DSH desktop sidebar and conversation area: font picking with installed-font detection, two-column layout, icon rail settings, terminal fonts, plus a visual settings panel. Pure style injection; no other plugin is modified.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "tangolee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangolee/dsh-sidebar-tuner.git"
  },
  "homepage": "https://github.com/tangolee/dsh-sidebar-tuner#readme",
  "bugs": {
    "url": "https://github.com/tangolee/dsh-sidebar-tuner/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "theme",
    "font"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./css": "./css.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "css.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples",
    "assets",
    "THIRD_PARTY_NOTICES.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.2-rc.3": "compatible",
        "0.2.2-rc.4": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "scripts": {
    "check": "node scripts/check-plugin.mjs && node scripts/verify-host.mjs && node scripts/verify-entry.mjs",
    "verify": "node scripts/verify-entry.mjs",
    "check:listing": "node scripts/check-listing.mjs"
  }
}
